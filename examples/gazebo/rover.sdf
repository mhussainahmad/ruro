<?xml version="1.0"?>
<!--
  A walled 8 m x 8 m arena with two boxes and a small differential-drive rover
  with a 360-degree lidar, for Gazebo Harmonic (gz sim 8). Topics, as seen by
  ros_gz_bridge: /cmd_vel (gz.msgs.Twist, in), /odom (gz.msgs.Odometry),
  /scan (gz.msgs.LaserScan) and /clock. See README.md.
-->
<sdf version="1.9">
  <world name="arena">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- The lidar is rendered (gpu_lidar); headless servers need EGL. -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </visual>
      </link>
    </model>

    <model name="walls">
      <static>true</static>
      <link name="north">
        <pose>4 0 0.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.1 8 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 8 0.5</size></box></geometry></visual>
      </link>
      <link name="south">
        <pose>-4 0 0.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.1 8 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 8 0.5</size></box></geometry></visual>
      </link>
      <link name="east">
        <pose>0 -4 0.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>8 0.1 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>8 0.1 0.5</size></box></geometry></visual>
      </link>
      <link name="west">
        <pose>0 4 0.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>8 0.1 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>8 0.1 0.5</size></box></geometry></visual>
      </link>
    </model>

    <model name="box_ahead">
      <static>true</static>
      <pose>2 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.5 1.0 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.5 1.0 0.5</size></box></geometry></visual>
      </link>
    </model>

    <model name="box_side">
      <static>true</static>
      <pose>-1.5 2 0.25 0 0 0.5</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.8 0.8 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.8 0.8 0.5</size></box></geometry></visual>
      </link>
    </model>

    <model name="rover">
      <pose>0 0 0.06 0 0 0</pose>
      <link name="base_link">
        <inertial>
          <mass>2.0</mass>
          <inertia><ixx>0.01</ixx><iyy>0.02</iyy><izz>0.025</izz></inertia>
        </inertial>
        <collision name="c"><geometry><box><size>0.3 0.2 0.08</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.3 0.2 0.08</size></box></geometry></visual>
      </link>
      <link name="caster">
        <pose>-0.12 0 -0.03 0 0 0</pose>
        <inertial><mass>0.05</mass><inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz></inertia></inertial>
        <collision name="c">
          <geometry><sphere><radius>0.03</radius></sphere></geometry>
          <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
        </collision>
      </link>
      <joint name="caster_joint" type="fixed">
        <parent>base_link</parent>
        <child>caster</child>
      </joint>
      <link name="left_wheel">
        <pose>0.05 0.125 0 -1.5708 0 0</pose>
        <inertial><mass>0.2</mass><inertia><ixx>2e-4</ixx><iyy>2e-4</iyy><izz>3e-4</izz></inertia></inertial>
        <collision name="c"><geometry><cylinder><radius>0.06</radius><length>0.03</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.06</radius><length>0.03</length></cylinder></geometry></visual>
      </link>
      <link name="right_wheel">
        <pose>0.05 -0.125 0 -1.5708 0 0</pose>
        <inertial><mass>0.2</mass><inertia><ixx>2e-4</ixx><iyy>2e-4</iyy><izz>3e-4</izz></inertia></inertial>
        <collision name="c"><geometry><cylinder><radius>0.06</radius><length>0.03</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.06</radius><length>0.03</length></cylinder></geometry></visual>
      </link>
      <joint name="left_wheel_joint" type="revolute">
        <parent>base_link</parent>
        <child>left_wheel</child>
        <axis><xyz expressed_in="__model__">0 1 0</xyz></axis>
      </joint>
      <joint name="right_wheel_joint" type="revolute">
        <parent>base_link</parent>
        <child>right_wheel</child>
        <axis><xyz expressed_in="__model__">0 1 0</xyz></axis>
      </joint>
      <link name="lidar_link">
        <pose>0.05 0 0.07 0 0 0</pose>
        <inertial><mass>0.05</mass><inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz></inertia></inertial>
        <visual name="v"><geometry><cylinder><radius>0.03</radius><length>0.04</length></cylinder></geometry></visual>
        <sensor name="lidar" type="gpu_lidar">
          <topic>scan</topic>
          <update_rate>10</update_rate>
          <always_on>true</always_on>
          <lidar>
            <scan>
              <horizontal>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
              </horizontal>
              <vertical>
                <samples>1</samples>
                <min_angle>0</min_angle>
                <max_angle>0</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.12</min>
              <max>10.0</max>
              <resolution>0.01</resolution>
            </range>
          </lidar>
        </sensor>
      </link>
      <joint name="lidar_joint" type="fixed">
        <parent>base_link</parent>
        <child>lidar_link</child>
      </joint>
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.25</wheel_separation>
        <wheel_radius>0.06</wheel_radius>
        <odom_publish_frequency>20</odom_publish_frequency>
        <topic>/cmd_vel</topic>
        <odom_topic>/odom</odom_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>
      </plugin>
    </model>
  </world>
</sdf>
